# Inspector UI → proxy API. Change if you run the inspector on another port.
NEXT_PUBLIC_INSPECTOR_URL=http://localhost:4040

# ── Proxy settings (server/proxy.mjs) ─────────────────────────────────
# Every one of these also has a CLI flag, e.g. --target-port 8000.

# Where your app is listening — the proxy forwards to it.
# TARGET_HOST=127.0.0.1
# TARGET_PORT=3000

# Where cloudflared should point.
# PROXY_HOST=127.0.0.1
# PROXY_PORT=8080

# SSE + API server the inspector UI reads from.
# INSPECTOR_HOST=127.0.0.1
# INSPECTOR_PORT=4040

# Capture limits.
# MAX_ENTRIES=200
# MAX_BODY_BYTES=262144

# Comma-separated headers to hide from the UI, so it is safe to screen-share.
# REDACT_HEADERS=authorization,cookie,set-cookie

# Extra browser origins allowed to read the API (loopback is always allowed).
# ALLOW_ORIGIN=http://localhost:3001

# Rewrite the Host header to the target instead of preserving the tunnel's.
# REWRITE_HOST=true
